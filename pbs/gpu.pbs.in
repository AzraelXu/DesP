#!/bin/bash
@QUEUE_DIRECTIVE@
#PBS -N @JOBNAME@
#PBS -l nodes=1:ppn=1:gpus=1
@WALLTIME_DIRECTIVE@
#PBS -j oe
#PBS -r n
#PBS -o @PBS_OUT@
# System: @SYSTEM_NAME@
# Stage: @STAGE@ (one GPU)
# This file is rendered by submit_system.sh. Do not edit by hand.
set -euo pipefail
# Some Torque setups do not deliver #PBS -o output; capture it ourselves.
exec >> "@PBS_OUT@" 2>&1
# PBS stdout is a file parsed by status.sh; never emit ANSI into it.
export SCH_COLOR=never

PIPELINE_ROOT="@PIPELINE_ROOT@"
PROJECT_DIR="@PROJECT_DIR@"
RUN_ID="@RUN_ID@"
export PIPELINE_ROOT PROJECT_DIR RUN_ID

source "${PROJECT_DIR}/project.resolved.conf"
source "${PIPELINE_ROOT}/scripts/lib/common.sh"
source "${PIPELINE_ROOT}/scripts/lib/gpu.sh"

setup_schrodinger_env
select_gpu

bash "@STAGE_SCRIPT@" "${PROJECT_DIR}"
